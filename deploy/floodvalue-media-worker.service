# systemd: scheduled collection of media sources (GDACS, GDELT, RSS), separate from the site (#174).
[Unit]
Description=FloodValue media worker
After=network-online.target
Wants=network-online.target

[Service]
User=floodvalue
WorkingDirectory=/opt/floodvalue
EnvironmentFile=/etc/floodvalue.env
# The venv from `make setup` (uv sync --frozen): no uv on systemd's PATH needed at runtime.
ExecStart=/opt/floodvalue/.venv/bin/python -m floodvalue.media worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/floodvalue/outputs
Restart=on-failure

[Install]
WantedBy=multi-user.target
