# /etc/floodvalue.env — secrets live here, never in git.
FLOODVALUE_SITE_PUBLIC=1
# Analyst login for /media/analyst and moderation; the site refuses to start public without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOODVALUE_MEDIA_ANALYST_TOKEN=
# Accept eyewitness reports from the internet (legal basis and moderation: docs/features/media-monitoring.md, К).
FLOODVALUE_MEDIA_PUBLIC_REPORTS=1
# The operator UI is public for now: its «Сообщения» layer opens without login, report points ≈ 1 km.
FLOODVALUE_MEDIA_OPERATOR_MAP_PUBLIC=1
FLOODVALUE_OUTPUT_DIR=/opt/floodvalue/outputs
FLOODVALUE_DATA_DIR=/opt/floodvalue/data
# One bundle for the operator UI (otherwise the newest complete bundle in FLOODVALUE_OUTPUT_DIR):
# FLOODVALUE_APP_RUN_DIR=/opt/floodvalue/outputs/<run_id>
# Port of the site process (serve_site.py --port default). If 8000 is taken, change it here and in
# every reverse_proxy of the Caddyfile:
# FLOODVALUE_APP_PORT=8000
# Never set FLOODVALUE_APP_ALLOW_TEST on a public server: a test chip opens only through its finished
# bundle after eval-test (D-033, D-050).
