# Скопировать в .env (он в .gitignore). Значения — плейсхолдеры.
# Каталог данных вне git: сюда качается Sen1Floods11 (docs/data.md). По умолчанию ./data
FLOODVALUE_DATA_DIR=./data
# Каталог результатов запуска (12 обязательных файлов). По умолчанию ./outputs
FLOODVALUE_OUTPUT_DIR=./outputs
# Лимит размера файла вне Git LFS для стража коммита, МБ
FLOODVALUE_MAX_FILE_MB=5
# Токен GitVerse для скрипта зеркалирования (только если он нужен; не коммитить)
GITVERSE_TOKEN=your_token_here
GITVERSE_USER=your_gitverse_login
# --- Мониторинг сообщений и форма очевидцев (python -m floodvalue.media, docs/features/media-monitoring-run.md)
# База и фото вне git. По умолчанию $FLOODVALUE_OUTPUT_DIR/media
FLOODVALUE_MEDIA_DIR=./outputs/media
# Токен аналитика. Пусто — операторские действия только с этой машины (loopback)
FLOODVALUE_MEDIA_ANALYST_TOKEN=
# 1 — приём обращений не только с loopback. Не включать без решения человека (правовые условия)
FLOODVALUE_MEDIA_PUBLIC_REPORTS=
# Интервал опроса всех источников, с. Пусто — poll_interval_s из src/floodvalue/media/sources.yaml (900)
FLOODVALUE_MEDIA_POLL_INTERVAL_S=
FLOODVALUE_MEDIA_MAX_ITEMS_PER_CYCLE=200
FLOODVALUE_MEDIA_MAX_REQUESTS_PER_CYCLE=20
# Вызовов языковой модели за цикл; провайдер не подключён
FLOODVALUE_MEDIA_LLM_MAX_CALLS=0
# none | nominatim (публичный OSM Nominatim: не больше 1 запроса/с, результаты кешируются)
FLOODVALUE_MEDIA_GEOCODER=none
FLOODVALUE_MEDIA_RETENTION_DAYS=90
FLOODVALUE_MEDIA_REPORTS_PER_HOUR=5
